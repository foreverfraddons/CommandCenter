package-as: CommandCenter

move-folders:
  CommandCenter/CommandCenter: CommandCenter

# The Forever database ships as its own CurseForge project (ForeverDB, project 1807282).
# The CurseForge app installs it with Command Center. Without it, Command Center still works
# (Questie and your own recordings only).
required-dependencies:
  - forever-db

ignore:
  - collected
  - sync
  - README.md
  - .github
